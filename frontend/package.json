{
  "name": "cabinet-juridique-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004 --webpack",
    "dev:pre": "scripts\\pre-dev.bat && next dev -p 3004 --webpack",
    "dev:alt": "next dev -p 3001",
    "kill-port": "node scripts/kill-port.js 3004",
    "kill-port:ps1": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 -Port 3004",
    "dev:clean": "npm run kill-port && timeout /t 2 /nobreak >nul && npm run dev",
    "build": "next build",
    "start": "next start -p 3004",
    "start:alt": "next start -p 3001",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "axios": "^1.6.2",
    "clsx": "^2.1.0",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.309.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.7",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.110.0"
  }
}
